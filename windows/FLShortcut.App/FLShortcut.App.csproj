<Project Sdk="Microsoft.NET.Sdk">

  <!-- Appli Windows 11 (WinUI 3, non empaquetée). Se compile uniquement sous Windows (dotnet build). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>FLShortcut.App</RootNamespace>
    <AssemblyName>FLShortcut</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Windows App SDK 1.6 exige Microsoft.Windows.SDK.NET.Ref *.*.*.38 ou plus récent (notes de version 1.6) :
         sans cela, un SDK .NET 8 antérieur à 8.0.4xx refuse la compilation. -->
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <Product>FL Shortcuts</Product>
    <Company>FL Shortcuts</Company>
    <Description>Raccourcis personnalisés pour FL Studio — outil indépendant, non affilié à Image-Line.</Description>
    <ApplicationIcon Condition="Exists('Assets\FLShortcut.ico')">Assets\FLShortcut.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Auto-contenu (runtime .NET + Windows App SDK copiés à côté de l'exe) quand un RID est donné :
       `dotnet publish -r win-x64 -p:Platform=x64`. Sans RID (simple `dotnet build`), SelfContained=true
       provoquerait NETSDK1031. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Serveur du compte, de la Communauté et de l'Aide : le MÊME que le Mac (Resources/Info.plist), adresse et clé
       publique (publique par conception : les règles de supabase/schema.sql protègent les données ; jamais la clé
       secrète ici). Les variables FLS_SUPABASE_URL et FLS_SUPABASE_ANON_KEY les remplacent si elles sont données
       toutes les deux, comme build.sh. 04/11 : sans elles, l'app Windows n'avait aucun serveur (secrets vides sur la
       CI) : compte, Communauté, sauvegarde et message à l'équipe ne marchaient pas. Essai : ServerAddressSameAsMac. -->
  <PropertyGroup>
    <FLSServerURL>https://ulzxunuytsakxrvovxen.supabase.co</FLSServerURL>
    <FLSServerKey>sb_publishable_uSqh6eUCCeoXMioONoQYIQ_rYlriiw8</FLSServerKey>
    <FLSServerURL Condition="'$(FLS_SUPABASE_URL)' != '' and '$(FLS_SUPABASE_ANON_KEY)' != ''">$(FLS_SUPABASE_URL)</FLSServerURL>
    <FLSServerKey Condition="'$(FLS_SUPABASE_URL)' != '' and '$(FLS_SUPABASE_ANON_KEY)' != ''">$(FLS_SUPABASE_ANON_KEY)</FLSServerKey>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="FLSCommunityURL" Value="$(FLSServerURL)" />
    <AssemblyMetadata Include="FLSCommunityAnonKey" Value="$(FLSServerKey)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FLShortcut.Core\FLShortcut.Core.csproj" />
  </ItemGroup>

  <!-- Windows MIDI Services (08/11) : sur Windows 11 25H2 à jour, l'appli crée elle-même ses deux ports MIDI, sans
       loopMIDI (Services/MidiServicesPorts.cs). L'API n'est pas encore dans le SDK Windows : ses métadonnées
       (ThirdParty/WindowsMidiServices, MIT) donnent une projection C# (CsWinRT), générée seulement sous Windows, où son
       outil existe ; ailleurs (compilation de contrôle sous Linux), le code dit « indisponible » (MIDI_SERVICES). -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);MIDI_SERVICES</DefineConstants>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <CsWinRTInputs Include="..\ThirdParty\WindowsMidiServices\Windows.Devices.Midi2.winmd" />
  </ItemGroup>

  <!-- L'IA intégrée de l'Organiser (YAMNet + têtes apprises), à côté de l'exécutable (ClasseurSons.Partage). -->
  <ItemGroup>
    <None Include="..\..\ia\modele\classeur_sons.onnx" Link="classeur_sons.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Le script FL (modèle avec le marqueur de clé), embarqué dans l'exécutable. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\device_FLShortcut.py" LogicalName="device_FLShortcut.py" />
    <!-- Tuto de l'Organiser : les images du Mac (Resources/{fr,en}.lproj/OrganiserTuto1…4.png). -->
    <EmbeddedResource Include="..\..\Resources\fr.lproj\OrganiserTuto*.png" LogicalName="%(Filename)-fr.png" />
    <EmbeddedResource Include="..\..\Resources\en.lproj\OrganiserTuto*.png" LogicalName="%(Filename)-en.png" />
    <!-- Logo « A » de la zone de notification (04/11, scripts/icone.py, option tray) : cercle blanc sur une barre des
         tâches sombre, noir sur une claire ; le rond toujours rouge (TrayIcon). -->
    <EmbeddedResource Include="Assets\TraySombre.ico" LogicalName="TraySombre.ico" />
    <EmbeddedResource Include="Assets\TrayClaire.ico" LogicalName="TrayClaire.ico" />
  </ItemGroup>

</Project>
