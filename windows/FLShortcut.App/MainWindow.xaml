<?xml version="1.0" encoding="utf-8"?>
<!-- Fenêtre Windows 11 : fond Mica, barre de titre haute intégrée, volet de navigation à gauche (comme
     Réglages), zone de contenu en couche arrondie, cartes Fluent, notification en acrylique. -->
<Window
    x:Class="FLShortcut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FL Shortcuts">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre (contenu étendu dans la barre) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AppIconGradient}">
                    <FontIcon Glyph="&#xE765;" FontSize="11" Foreground="White" />
                </Border>
                <TextBlock Text="FL Shortcuts" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border x:Name="PausePill" Visibility="Collapsed" CornerRadius="10" Padding="8,1,8,2" VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock Text="En pause" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Accueil 1/2 : ports MIDI ===== -->
        <ScrollViewer x:Name="StepPorts" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="StepPortsContent" MaxWidth="560" Spacing="12" Padding="48,16,48,40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="18" HorizontalAlignment="Center" Background="{StaticResource AppIconGradient}">
                    <FontIcon Glyph="&#xE765;" FontSize="36" Foreground="White" />
                </Border>
                <TextBlock Text="Bienvenue dans FL Shortcuts" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="28" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Text="Crée tes propres raccourcis pour FL Studio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                <Border Style="{StaticResource Card}" Padding="16,10" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel x:Name="ExampleCaps" Orientation="Horizontal" Spacing="4" />
                        <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Ouvrir le Mixer, sans chercher F9" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock MaxWidth="420" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="FL Shortcuts ne regarde tes touches que quand FL Studio est au premier plan. Rien n'est enregistré ni envoyé." />
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" VerticalAlignment="Top">
                            <Ellipse x:Name="PortsHalo" Opacity="0.16" />
                            <FontIcon x:Name="PortsIcon" Glyph="&#xE8A1;" FontSize="18" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Ports MIDI « FL Shortcuts »" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PortsText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="LoopMidiLink" Content="Télécharger loopMIDI (gratuit)" NavigateUri="https://www.tobias-erichsen.de/software/loopmidi.html" Padding="0" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="PortsContinue" Style="{StaticResource AccentButtonStyle}" MinWidth="180" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnPortsContinue" />
                <HyperlinkButton x:Name="PortsBack" Content="Retour aux raccourcis" HorizontalAlignment="Center" Click="OnBackToMain" Visibility="Collapsed" />
                <PipsPager NumberOfPages="2" SelectedPageIndex="0" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Accueil 2/2 : relier FL Studio ===== -->
        <ScrollViewer x:Name="StepLink" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="StepLinkContent" MaxWidth="660" Spacing="10" Padding="48,16,48,40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Relier FL Studio" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="À faire une seule fois." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                <Grid ColumnSpacing="12" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LinkSteps" Spacing="2" />
                    <!-- Aperçu de la fenêtre MIDI Settings de FL, avec les deux endroits où cliquer -->
                    <Border Grid.Column="1" CornerRadius="8" Background="#2B2F33" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#3A4046" Padding="10,7" CornerRadius="8,8,0,0">
                                <TextBlock Text="Options › MIDI Settings" Foreground="#E6EBEE" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Padding="10,8" Spacing="4">
                                <TextBlock Text="Input" Foreground="#99C9D1D6" FontSize="11" />
                                <Border Padding="6,4" CornerRadius="3" BorderBrush="#FFB34D" BorderThickness="2" Background="#2EFFAA3C">
                                    <TextBlock Text="FL Shortcuts   ①" Foreground="#FFCF8A" FontSize="11" />
                                </Border>
                                <TextBlock Text="Output" Foreground="#99C9D1D6" FontSize="11" Margin="0,4,0,0" />
                                <Border Padding="6,4" CornerRadius="3" BorderBrush="#FFB34D" BorderThickness="2" Background="#2EFFAA3C">
                                    <TextBlock Text="FL Shortcuts Retour   ②" Foreground="#FFCF8A" FontSize="11" />
                                </Border>
                                <TextBlock Text="Controller type : FL Shortcuts · Port : même numéro" Foreground="#C9D1D6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar x:Name="LinkInfo" IsOpen="True" IsClosable="False" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="LinkPrimary" Style="{StaticResource AccentButtonStyle}" MinWidth="180" Click="OnLinkPrimary" />
                    <Button x:Name="LinkTest" MinWidth="120" Click="OnTest" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Tester" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LinkChooseFolder" Content="Choisir le dossier de FL…" Click="OnChooseFolder" Visibility="Collapsed" />
                </StackPanel>
                <HyperlinkButton x:Name="LinkBack" Content="Retour aux raccourcis" HorizontalAlignment="Center" Click="OnBackToMain" Visibility="Collapsed" />
                <PipsPager NumberOfPages="2" SelectedPageIndex="1" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Application : volet de rubriques + liste ===== -->
        <NavigationView x:Name="MainView" Grid.Row="1" Visibility="Collapsed"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="232"
                        SelectionChanged="OnNavChanged" ItemInvoked="OnNavInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavAll" Content="Tous les raccourcis" Tag="" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavComposition" Content="Composition" Tag="Composition">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavRecording" Content="Enregistrement" Tag="Enregistrement">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavMix" Content="Mix" Tag="Mix">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNavigation" Content="Navigation" Tag="Navigation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavKeys" Content="Touches de FL" Tag="Touches de FL">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavLink" Content="Relier FL Studio" Tag="#link" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="MainContent" Padding="40,28,40,0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Titre de la page + interrupteur général -->
                <Grid>
                    <TextBlock x:Name="PageTitle" Text="Raccourcis" Style="{StaticResource TitleTextBlockStyle}" FontSize="28" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnabledSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"
                                  OnContent="Activé" OffContent="En pause" Toggled="OnEnabledToggled" />
                </Grid>

                <!-- Carte d'état du lien -->
                <Border x:Name="StatusCard" Grid.Row="1" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="StatusBadge" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                            <Ellipse x:Name="StatusHalo" Opacity="0.16" />
                            <FontIcon x:Name="StatusGlyph" FontSize="18" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="StatusAction" Grid.Column="2" Content="Réparer" VerticalAlignment="Center" Click="OnRepair" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Barre d'outils -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher un raccourci" QueryIcon="Find" TextChanged="OnSearchChanged" />
                    <DropDownButton x:Name="ProfileButton" Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock x:Name="ProfileLabel" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ProfileMenu" Placement="Bottom" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnNewShortcut">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Nouveau raccourci" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="3" Margin="0,0,-20,0" Padding="0,0,20,0">
                    <StackPanel x:Name="GroupsPanel" Spacing="24" Padding="0,4,0,96" />
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Notification éphémère en acrylique (« Raccourci ajouté », « Annuler ») -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Padding="14,8,6,8" MinHeight="48" MaxWidth="560" Visibility="Collapsed" RenderTransformOrigin="0.5,1"
                CornerRadius="{StaticResource OverlayCornerRadius}" BorderThickness="1"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="ToastIcon" FontSize="16" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" MaxWidth="400" TextWrapping="Wrap" />
                <Button x:Name="ToastUndo" Content="Annuler" VerticalAlignment="Center" Click="OnToastUndo" Visibility="Collapsed" />
                <Button Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="OnToastClose" ToolTipService.ToolTip="Fermer">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
