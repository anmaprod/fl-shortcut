<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FLShortcut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FL Shortcut">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre (contenu étendu dans la barre, style Windows 11) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="FL Shortcut" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ===== Accueil : préparer la connexion ===== -->
        <ScrollViewer x:Name="StepPorts" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="560" Spacing="12" Padding="48,24,48,48" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE765;" FontSize="64" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Bienvenue dans FL Shortcut" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="28" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="Crée tes propres raccourcis pour FL Studio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                <Border Padding="16,10" CornerRadius="6" HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel x:Name="ExampleCaps" Orientation="Horizontal" Spacing="4" />
                        <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Ouvrir le Mixer, sans chercher F9" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock MaxWidth="420" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="FL Shortcut ne regarde tes touches que quand FL Studio est au premier plan. Rien n'est enregistré ni envoyé." />
                </StackPanel>

                <Border Margin="0,10,0,0" Padding="16,12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="PortsIcon" Glyph="&#xE8F4;" FontSize="18" />
                            <TextBlock Text="Ports MIDI « FL Shortcut »" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="PortsText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="LoopMidiLink" Content="Télécharger loopMIDI (gratuit)" NavigateUri="https://www.tobias-erichsen.de/software/loopmidi.html" Padding="0" />
                    </StackPanel>
                </Border>

                <Button x:Name="PortsContinue" Style="{StaticResource AccentButtonStyle}" MinWidth="160" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnPortsContinue" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Accueil : relier FL Studio ===== -->
        <ScrollViewer x:Name="StepLink" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="620" Spacing="10" Padding="48,24,48,48" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Relier FL Studio" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="À faire une seule fois." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                <Grid ColumnSpacing="12" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LinkSteps" Spacing="3" />
                    <Border Grid.Column="1" CornerRadius="6" Background="#2B2F33" Padding="0">
                        <StackPanel>
                            <Border Background="#3A4046" Padding="10,7" CornerRadius="6,6,0,0">
                                <TextBlock Text="Options › MIDI Settings" Foreground="#E6EBEE" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Padding="10,8" Spacing="4">
                                <TextBlock Text="Input" Foreground="#99C9D1D6" FontSize="11" />
                                <Border Padding="6,4" CornerRadius="3" BorderBrush="#FFB34D" BorderThickness="2" Background="#2EFFAA3C">
                                    <TextBlock Text="FL Shortcut   ①" Foreground="#FFCF8A" FontSize="11" />
                                </Border>
                                <TextBlock Text="Output" Foreground="#99C9D1D6" FontSize="11" Margin="0,4,0,0" />
                                <Border Padding="6,4" CornerRadius="3" BorderBrush="#FFB34D" BorderThickness="2" Background="#2EFFAA3C">
                                    <TextBlock Text="FL Shortcut Retour   ②" Foreground="#FFCF8A" FontSize="11" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <TextBlock Text="Controller type : FL Shortcut · Port : même numéro" Foreground="#C9D1D6" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar x:Name="LinkInfo" IsOpen="True" IsClosable="False" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="LinkPrimary" Style="{StaticResource AccentButtonStyle}" MinWidth="160" Click="OnLinkPrimary" />
                    <Button x:Name="LinkTest" Content="Tester" MinWidth="120" Click="OnTest" Visibility="Collapsed" />
                    <Button x:Name="LinkChooseFolder" Content="Choisir le dossier de FL…" Click="OnChooseFolder" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Application : liste des raccourcis ===== -->
        <Grid x:Name="MainView" Grid.Row="1" Visibility="Collapsed" Padding="36,4,36,0" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Raccourcis" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="28" />
                <ToggleSwitch x:Name="EnabledSwitch" HorizontalAlignment="Right" OnContent="Activé" OffContent="En pause" Toggled="OnEnabledToggled" />
            </Grid>

            <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="StatusAction" Content="Réparer" Click="OnRepair" Visibility="Collapsed" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher" QueryIcon="Find" TextChanged="OnSearchChanged" />
                <DropDownButton x:Name="ProfileButton" Grid.Column="1">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ProfileMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnNewShortcut">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Nouveau raccourci" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="3" Padding="0,0,0,24">
                <StackPanel x:Name="GroupsPanel" Spacing="16" Padding="0,0,0,24" />
            </ScrollViewer>
        </Grid>

        <!-- Notification éphémère (« Raccourci ajouté », « Annuler ») -->
        <InfoBar x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                 MaxWidth="520" IsOpen="False" IsClosable="True" Severity="Success" />
    </Grid>
</Window>
