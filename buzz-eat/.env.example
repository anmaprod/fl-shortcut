# Copiez ce fichier en .env (jamais envoyé sur GitHub) ou saisissez ces valeurs chez votre hébergeur.

# Adresse publique du site, en https : elle est écrite dans les QR codes et les liens de paiement.
PUBLIC_URL=https://buzz-eat.example.fr
# Mettre 1 derrière un hébergeur qui reçoit le HTTPS à votre place (Render, Railway, Fly.io, Nginx…).
TRUST_PROXY=1
PORT=3000
# Dossier de la base de données : doit être sur un disque persistant.
DATA_DIR=/data

# Codes promo « abonnement offert » (0 €), séparés par des virgules. Ne les écrivez jamais dans le dépôt.
PROMO_CODES_GRATUITS=

# Paiement de l'abonnement à 5 €/mois (tableau de bord Stripe › Développeurs).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Facultatif : un prix créé dans Stripe (sinon 5 €/mois est créé à la volée).
STRIPE_PRICE_ID=

# Notifications : adresse de contact donnée aux services des navigateurs.
VAPID_SUBJECT=mailto:contact@example.fr
# Facultatif : clés VAPID fixes (sinon créées une fois et gardées dans la base).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
